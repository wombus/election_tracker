# ──────────────────────────────────────────────────────────────────────────────
# Election Tracker configuration. Copy to .env.local and fill in what you have.
# ──────────────────────────────────────────────────────────────────────────────

# Which live-results sources to use, in priority order (comma separated).
#   ap    – Associated Press Elections API (official vote counts + race calls)
#   feed  – any JSON URL that follows the normalized schema in README.md
#   demo  – SIMULATED results for development (always labelled in the UI)
# Leave empty to auto-detect: "ap" if AP_API_KEY is set, plus "feed" if
# RESULTS_FEED_URL is set. With nothing configured the app shows every race
# from the roster as "awaiting results".
DATA_PROVIDERS=

# AP Elections API key (https://developer.ap.org/ap-elections-api/)
AP_API_KEY=
# Optional: restrict AP offices to reduce payload (e.g. "S,H,G"). Empty = all races.
AP_OFFICE_IDS=

# Optional custom JSON feed (see README "Bring your own feed").
RESULTS_FEED_URL=

# Refresh cadence (seconds). Server cache TTL and browser auto-refresh.
REFRESH_INTERVAL_SECONDS=300
# Minimum seconds between upstream fetches triggered by "Update now" clicks,
# shared across all visitors, so a busy night can't burn your API quota.
MIN_FORCED_REFRESH_SECONDS=20

# Simulator (DATA_PROVIDERS=demo) — development only, always labelled SIMULATED.
# Virtual clock speed multiplier and start time on election night (ET, 24h).
DEMO_SPEED=12
DEMO_START=18:45
